{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/characters/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/map/**",
              "components/passport/**",
              "components/places/**",
              "components/web/**",
              "reference/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Paytone One))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Paytone One."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|social|disabled|children|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, social, disabled, children, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost|ghost-light|ghost-brand)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'ghost-light' | 'ghost-brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|label|partner|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CategoryChip> doesn't accept that prop. Declared props: category, label, partner, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|size|color|style|key|ref|className|style|children)$/]",
        "message": "<CategoryIcon> doesn't accept that prop. Declared props: category, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryPin'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|partner|size|style|key|ref|className|style|children)$/]",
        "message": "<CategoryPin> doesn't accept that prop. Declared props: category, partner, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CityMap'] > JSXAttribute > JSXIdentifier[name!=/^(?:center|radius|theme|buildings|controls|height|minZoom|maxZoom|onMapClick|style|key|ref|className|style|children)$/]",
        "message": "<CityMap> doesn't accept that prop. Declared props: center, radius, theme, buildings, controls, height, minZoom, maxZoom, onMapClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CityMap'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<CityMap> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CursorCharacter'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|message|typeSpeed|holdMs|onDone|style|key|ref|className|style|children)$/]",
        "message": "<CursorCharacter> doesn't accept that prop. Declared props: name, color, message, typeSpeed, holdMs, onDone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuestbookNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|message|avatarSrc|photos|typeSpeed|postDelay|replayKey|onDone|style|key|ref|className|style|children)$/]",
        "message": "<GuestbookNote> doesn't accept that prop. Declared props: name, color, message, avatarSrc, photos, typeSpeed, postDelay, replayKey, onDone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|label|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, disabled, label, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|ghost)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Option'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Option> doesn't accept that prop. Declared props: icon, children, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Passport'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|defaultOpen|onToggle|width|duration|autoplay|autoplayDelay|interactive|centerClosed|closedSrc|openSrc|style|key|ref|className|style|children)$/]",
        "message": "<Passport> doesn't accept that prop. Declared props: open, defaultOpen, onToggle, width, duration, autoplay, autoplayDelay, interactive, centerClosed, closedSrc, openSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoStackMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:photos|count|category|partner|width|interval|animate|style|key|ref|className|style|children)$/]",
        "message": "<PhotoStackMarker> doesn't accept that prop. Declared props: photos, count, category, partner, width, interval, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|style|key|ref|className|style|children)$/]",
        "message": "<PlaceMarker> doesn't accept that prop. Declared props: src, alt, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|placeholder|onChange|theme|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, defaultValue, placeholder, onChange, theme, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<TextField> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|actionLabel|onAction|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, icon, children, actionLabel, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|warn|danger)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'success' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WebHeadlineLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|tone|key|ref|className|style|children)$/]",
        "message": "<WebHeadlineLine> doesn't accept that prop. Declared props: text, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='WebHeadlineLine'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|brand)$/]",
        "message": "<WebHeadlineLine> tone must be one of 'dark' | 'brand'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
